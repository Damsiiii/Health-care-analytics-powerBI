	partition Date_Table = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2023,1,1), DATE(2025,12,31)),
				    "Day", DAY ( [Date] ),
				    "Month", MONTH ( [Date] ),
				    "MonthName", FORMAT ( [Date], "MMMM" ),
				    "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				    "Year", YEAR ( [Date] )
				)
				
				```

	annotation PBI_Id = e2848a2e4fb84a7ea0da81a56bbbea56

